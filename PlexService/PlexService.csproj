<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>PlexService</RootNamespace>
    <AssemblyName>PlexService</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Platforms>x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
    <ApplicationIcon>PlexService.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Configuration.Install" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="PlexMediaServerService.cs" SubType="Component" />
    <Compile Update="PlexMediaServerService.Designer.cs" DependentUpon="PlexMediaServerService.cs" />
    <EmbeddedResource Update="PlexMediaServerService.resx" DependentUpon="PlexMediaServerService.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlexServiceCommon\PlexServiceCommon.csproj" />
    <ProjectReference Include="..\PlexServiceWCF\PlexServiceWCF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
