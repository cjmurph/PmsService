<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PlexServiceTray</RootNamespace>
    <AssemblyName>PlexServiceTray</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
    <ApplicationIcon>PlexService.ico</ApplicationIcon>
    <ApplicationManifest>PlexServiceTray.exe.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <None Update="LICENCE.rtf" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="PlexService.ico" />
    <Resource Include="PlexService_Bar.ico" />
    <EmbeddedResource Include="PlexService.ico" LogicalName="PlexServiceTray.PlexService.ico" />
    <EmbeddedResource Include="..\LICENSE.md" LogicalName="PlexServiceTray.LICENSE.md" Link="LICENSE.md" />
    <None Update="PlexService_Bar.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlexServiceCommon\PlexServiceCommon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
  </ItemGroup>

</Project>
