<ui:FluentWindow x:Class="PlexServiceTray.Windows.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:PlexServiceTray.Controls"
                 Title="Plex Service" Width="980" Height="700" MinWidth="820" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 Icon="/PlexServiceTray;component/PlexService_Bar.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <controls:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <controls:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <controls:ZeroToVisibleConverter x:Key="ZeroToVisible" />
        <controls:IntToDoubleConverter x:Key="IntToDouble" />

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="PageDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="2,20,0,8" />
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="RowDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- replaces the square red box WPF draws around invalid fields -->
        <ControlTemplate x:Key="FieldError">
            <Border BorderBrush="{DynamicResource SystemFillColorCriticalBrush}" BorderThickness="1" CornerRadius="4">
                <AdornedElementPlaceholder />
            </Border>
        </ControlTemplate>

        <Style x:Key="ShareTestMessage" TargetType="TextBlock" BasedOn="{StaticResource RowDescription}">
            <Setter Property="Margin" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TestState}" Value="Passed">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TestState}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- settings row, one card each like the Windows settings app -->
        <Style x:Key="Row" TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="MinHeight" Value="68" />
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="Number" TargetType="ui:NumberBox" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
            <Setter Property="Width" Value="140" />
            <Setter Property="MaxDecimalPlaces" Value="0" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="ClearButtonEnabled" Value="False" />
            <Setter Property="SpinButtonPlacementMode" Value="Inline" />
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource FieldError}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Field" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="ClearButtonEnabled" Value="False" />
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource FieldError}" />
        </Style>

        <Style x:Key="Pages" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- list item with the accent pill of Windows 11 -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="5" Background="Transparent" />
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppItem" TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Plex Service">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/PlexServiceTray;component/PlexService_Bar.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- navigation -->
            <DockPanel Grid.Column="0" Margin="12,4,12,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,20">
                    <Image Width="36" Height="36" Source="/PlexServiceTray;component/PlexService.ico" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Plex Media Server" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Ellipse Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionStatus}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="170" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ui:Button DockPanel.Dock="Bottom" Content="Reconnect" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Transparent"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ReconnectCommand}" />

                <ListBox SelectedIndex="{Binding SelectedPageIndex}" ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,14,0" />
                            <TextBlock Text="General" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Apps24" Margin="0,0,14,0" />
                            <TextBlock Text="Auxiliary apps" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Storage24" Margin="0,0,14,0" />
                            <TextBlock Text="Drive mappings" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Desktop24" Margin="0,0,14,0" />
                            <TextBlock Text="Tray app" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info24" Margin="0,0,14,0" />
                            <TextBlock Text="About" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>

            <!-- content layer -->
            <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TabControl Grid.Row="0" Style="{StaticResource Pages}" SelectedIndex="{Binding SelectedPageIndex, Mode=OneWay}">

                        <!-- General -->
                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,28,36,16">
                                <StackPanel MaxWidth="900">
                                    <TextBlock Text="General" Style="{StaticResource PageTitle}" />
                                    <TextBlock Text="How the service finds, runs and watches Plex Media Server." Style="{StaticResource PageDescription}" />
                                    <ui:InfoBar Title="Read only" Message="{Binding ServerNotice}" IsOpen="{Binding HasServerNotice, Mode=OneWay}"
                                                IsClosable="False" Severity="Warning" Margin="0,0,0,12" />

                                    <StackPanel IsEnabled="{Binding CanEditServer}">
                                        <TextBlock Text="Plex Media Server" Style="{StaticResource SectionHeader}" Margin="2,0,0,8" />
                                        <Border Style="{StaticResource Panel}">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,12">
                                                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Folder24" FontSize="20" Margin="2,0,16,0" VerticalAlignment="Top" />
                                                    <StackPanel>
                                                        <TextBlock Text="Location of Plex Media Server.exe" Style="{StaticResource RowTitle}" />
                                                        <TextBlock Text="Leave this empty unless Plex is installed in an unusual place and the service can't find it. The path is on the computer running the service."
                                                                   Style="{StaticResource RowDescription}" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <DockPanel Margin="38,0,0,0">
                                                    <ui:Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Command="{Binding BrowseForPlexCommand}" />
                                                    <ui:TextBox Style="{StaticResource Field}" PlaceholderText="Detected automatically"
                                                                Text="{Binding UserDefinedInstallLocation, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="Recovery" Style="{StaticResource SectionHeader}" />
                                        <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon ArrowSync24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="Restart Plex if it stops" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Starts Plex again when it exits or crashes without being stopped from here." Style="{StaticResource RowDescription}" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ui:ToggleSwitch IsChecked="{Binding AutoRestart}" />
                                        </ui:CardControl>
                                        <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Timer24}" IsEnabled="{Binding AutoRestart}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="Wait before restarting" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Seconds between Plex stopping and the service starting it again." Style="{StaticResource RowDescription}" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ui:NumberBox Style="{StaticResource Number}" Minimum="0" Maximum="3600"
                                                          Value="{Binding RestartDelay, Converter={StaticResource IntToDouble}}" />
                                        </ui:CardControl>

                                        <TextBlock Text="Service" Style="{StaticResource SectionHeader}" />
                                        <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon PlugConnected24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="Service port" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Port the tray app uses to talk to the service (default 8787). This is not the Plex port." Style="{StaticResource RowDescription}" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ui:NumberBox Style="{StaticResource Number}" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden"
                                                          Value="{Binding ServerPort, Converter={StaticResource IntToDouble}, ValidatesOnDataErrors=True}" />
                                        </ui:CardControl>
                                        <ui:InfoBar Message="The new port is used after the PlexService service has been restarted. Update the port on the Tray app page too."
                                                    IsOpen="{Binding PortChanged, Mode=OneWay}" IsClosable="False" Severity="Informational" Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Auxiliary apps -->
                        <TabItem>
                            <Grid Margin="36,28,36,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Auxiliary apps" Style="{StaticResource PageTitle}" />
                                    <TextBlock Style="{StaticResource PageDescription}"
                                               Text="Programs the service starts and stops together with Plex, for example a tuner, a downloader or a script." />
                                </StackPanel>
                                <ui:InfoBar Grid.Row="1" Title="Read only" Message="{Binding ServerNotice}" IsOpen="{Binding HasServerNotice, Mode=OneWay}"
                                            IsClosable="False" Severity="Warning" Margin="0,0,0,12" />

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="6" Margin="0">
                                        <DockPanel>
                                            <ui:Button DockPanel.Dock="Top" Content="Add application" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                                                       HorizontalAlignment="Stretch" Margin="4,4,4,8" Command="{Binding AddAuxAppCommand}" />
                                            <Grid>
                                                <ListBox ItemsSource="{Binding AuxiliaryApplications}" SelectedItem="{Binding SelectedAuxApplication}"
                                                         ItemContainerStyle="{StaticResource AppItem}" Background="Transparent" BorderThickness="0"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel>
                                                                <Ellipse DockPanel.Dock="Left" Margin="0,0,12,0">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Running}" Value="True">
                                                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="No applications yet" HorizontalAlignment="Center" Margin="0,16,0,0"
                                                           Visibility="{Binding AuxiliaryApplications.Count, Converter={StaticResource ZeroToVisible}}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                            </Grid>
                                        </DockPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="0" Margin="0">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                                        Visibility="{Binding HasSelectedAuxApplication, Converter={StaticResource InverseBoolToVisibility}}">
                                                <ui:SymbolIcon Symbol="Apps24" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="Select an application or add a new one." Style="{StaticResource RowDescription}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                            </StackPanel>

                                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18"
                                                          DataContext="{Binding SelectedAuxApplication}"
                                                          Visibility="{Binding DataContext.HasSelectedAuxApplication, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,18">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:Button Icon="{ui:SymbolIcon Play24}" ToolTip="Start now" Command="{Binding StartCommand}" />
                                                            <ui:Button Icon="{ui:SymbolIcon Stop24}" ToolTip="Stop now" Command="{Binding StopCommand}" Margin="6,0,0,0" />
                                                            <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="Remove application" Margin="6,0,0,0"
                                                                       Command="{Binding DataContext.RemoveAuxAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource RowDescription}" />
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <StackPanel IsEnabled="{Binding DataContext.CanEditServer, RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                                                        <ui:TextBox Style="{StaticResource Field}" Margin="0,0,0,14"
                                                                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                                                        <TextBlock Text="Program" Style="{StaticResource FieldLabel}" />
                                                        <DockPanel Margin="0,0,0,14">
                                                            <ui:Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Command="{Binding BrowseCommand}" />
                                                            <ui:TextBox Style="{StaticResource Field}" PlaceholderText="C:\Path\To\Program.exe"
                                                                        Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                                                        </DockPanel>

                                                        <TextBlock Text="Arguments" Style="{StaticResource FieldLabel}" />
                                                        <ui:TextBox Style="{StaticResource Field}" PlaceholderText="Optional" Margin="0,0,0,14"
                                                                    Text="{Binding Argument, UpdateSourceTrigger=PropertyChanged}" />

                                                        <TextBlock Text="Working folder" Style="{StaticResource FieldLabel}" />
                                                        <DockPanel Margin="0,0,0,14">
                                                            <ui:Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Command="{Binding BrowseFolderCommand}" />
                                                            <ui:TextBox Style="{StaticResource Field}" PlaceholderText="Folder of the program"
                                                                        Text="{Binding WorkingFolder, UpdateSourceTrigger=PropertyChanged}" />
                                                        </DockPanel>

                                                        <TextBlock Text="Web interface" Style="{StaticResource FieldLabel}" />
                                                        <DockPanel>
                                                            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Open24}" Margin="8,0,0,0" ToolTip="Open in browser"
                                                                       Command="{Binding OpenUrlCommand}" />
                                                            <ui:TextBox Style="{StaticResource Field}" PlaceholderText="http://localhost:1234 (optional)"
                                                                        Text="{Binding Url, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                                                        </DockPanel>
                                                        <TextBlock Text="Adds a shortcut to the tray menu." Style="{StaticResource RowDescription}" Margin="0,6,0,18" />

                                                        <ui:CardControl Style="{StaticResource Row}">
                                                            <ui:CardControl.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="Keep running" Style="{StaticResource RowTitle}" />
                                                                    <TextBlock Text="Restart the program when it exits. Turn this off for scripts that run once." Style="{StaticResource RowDescription}" />
                                                                </StackPanel>
                                                            </ui:CardControl.Header>
                                                            <ui:ToggleSwitch IsChecked="{Binding KeepAlive}" />
                                                        </ui:CardControl>
                                                        <ui:CardControl Style="{StaticResource Row}">
                                                            <ui:CardControl.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="Write output to the service log" Style="{StaticResource RowTitle}" />
                                                                    <TextBlock Text="Useful to find out why a program doesn't work." Style="{StaticResource RowDescription}" />
                                                                </StackPanel>
                                                            </ui:CardControl.Header>
                                                            <ui:ToggleSwitch IsChecked="{Binding LogOutput}" />
                                                        </ui:CardControl>
                                                        <ui:CardControl Style="{StaticResource Row}">
                                                            <ui:CardControl.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="Start before Plex" Style="{StaticResource RowTitle}" />
                                                                    <TextBlock Text="For programs Plex needs when it starts, like a tuner." Style="{StaticResource RowDescription}" />
                                                                </StackPanel>
                                                            </ui:CardControl.Header>
                                                            <ui:ToggleSwitch IsChecked="{Binding StartBeforePlex}" />
                                                        </ui:CardControl>
                                                        <ui:CardControl Style="{StaticResource Row}" IsEnabled="{Binding StartBeforePlex}">
                                                            <ui:CardControl.Header>
                                                                <StackPanel>
                                                                    <TextBlock Text="Then wait before starting Plex" Style="{StaticResource RowTitle}" />
                                                                    <TextBlock Text="Seconds to give the program to get ready." Style="{StaticResource RowDescription}" />
                                                                </StackPanel>
                                                            </ui:CardControl.Header>
                                                            <ui:NumberBox Style="{StaticResource Number}" Minimum="0" Maximum="600"
                                                                          Value="{Binding StartDelay, Converter={StaticResource IntToDouble}}" />
                                                        </ui:CardControl>
                                                    </StackPanel>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- Drive mappings -->
                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,28,36,16">
                                <StackPanel MaxWidth="900">
                                    <TextBlock Text="Drive mappings" Style="{StaticResource PageTitle}" />
                                    <TextBlock Style="{StaticResource PageDescription}"
                                               Text="Network shares the service connects before starting Plex. Drives mapped in your own session aren't visible to a service, so libraries on a NAS need to be mapped here. Without a user name the share is accessed with the account of the service. New or changed shares are tested when you save." />
                                    <ui:InfoBar Title="Read only" Message="{Binding ServerNotice}" IsOpen="{Binding HasServerNotice, Mode=OneWay}"
                                                IsClosable="False" Severity="Warning" Margin="0,0,0,12" />

                                    <StackPanel IsEnabled="{Binding CanEditServer}">
                                        <DockPanel Margin="2,0,0,8">
                                            <ui:Button DockPanel.Dock="Right" Content="Add mapping" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                                                       Command="{Binding AddDriveMapCommand}" />
                                            <TextBlock Text="Mapped drives" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <Border Style="{StaticResource Panel}" Visibility="{Binding DriveMaps.Count, Converter={StaticResource ZeroToVisible}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Storage24" FontSize="20" Margin="2,0,16,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="No drives are mapped." Style="{StaticResource RowDescription}" VerticalAlignment="Center" Margin="0" />
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding DriveMaps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Panel}" Padding="16,12">
                                                        <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ui:SymbolIcon Grid.Column="0" Symbol="HardDrive20" FontSize="20" Margin="2,0,16,0" />
                                                            <ComboBox Grid.Column="1" VerticalAlignment="Center" Validation.ErrorTemplate="{StaticResource FieldError}"
                                                                      ItemsSource="{Binding AvailableLetters}"
                                                                      SelectedItem="{Binding DriveLetter, ValidatesOnDataErrors=True}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding StringFormat={}{0}:}" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <ui:SymbolIcon Grid.Column="2" Symbol="ArrowRight16" Margin="12,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            <ui:TextBox Grid.Column="3" Style="{StaticResource Field}" PlaceholderText="\\server\share" VerticalAlignment="Center"
                                                                        Text="{Binding ShareName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                                                            <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Delete24}" Margin="8,0,0,0" ToolTip="Remove mapping" Appearance="Transparent"
                                                                       Command="{Binding DataContext.RemoveDriveMapCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       CommandParameter="{Binding}" />
                                                        </Grid>
                                                        <Grid Margin="38,10,48,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="12" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <ui:TextBox Grid.Column="0" Style="{StaticResource Field}" PlaceholderText="User name (optional)"
                                                                        Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                                                            <ui:PasswordBox Grid.Column="2" PlaceholderText="{Binding PasswordHint}" Validation.ErrorTemplate="{StaticResource FieldError}"
                                                                            Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                                                        </Grid>
                                                        <DockPanel Margin="38,10,48,2">
                                                            <ui:Button DockPanel.Dock="Left" Content="Test connection" Icon="{ui:SymbolIcon PlugConnected24}" VerticalAlignment="Top"
                                                                       Command="{Binding TestCommand}" />
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0" DockPanel.Dock="Left">
                                                                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16"
                                                                                 Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibility}}" />
                                                                <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="18" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                                               Visibility="{Binding IsPassed, Converter={StaticResource BoolToVisibility}}" />
                                                                <ui:SymbolIcon Symbol="ErrorCircle20" FontSize="18" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                                               Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding TestMessage}" VerticalAlignment="Center" Style="{StaticResource ShareTestMessage}" />
                                                        </DockPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="When a mapping fails" Style="{StaticResource SectionHeader}" />
                                        <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon ArrowRepeatAll24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="Try again" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Helps when the NAS or network isn't ready yet right after boot." Style="{StaticResource RowDescription}" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ui:ToggleSwitch IsChecked="{Binding AutoRemount}" />
                                        </ui:CardControl>
                                        <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon NumberSymbol24}" IsEnabled="{Binding AutoRemount}">
                                            <ui:CardControl.Header>
                                                <TextBlock Text="Attempts" Style="{StaticResource RowTitle}" />
                                            </ui:CardControl.Header>
                                            <ui:NumberBox Style="{StaticResource Number}" Minimum="1" Maximum="100"
                                                          Value="{Binding AutoRemountCount, Converter={StaticResource IntToDouble}}" />
                                        </ui:CardControl>
                                        <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Timer24}" IsEnabled="{Binding AutoRemount}">
                                            <ui:CardControl.Header>
                                                <TextBlock Text="Seconds between attempts" Style="{StaticResource RowTitle}" />
                                            </ui:CardControl.Header>
                                            <ui:NumberBox Style="{StaticResource Number}" Minimum="0" Maximum="600"
                                                          Value="{Binding AutoRemountDelay, Converter={StaticResource IntToDouble}}" />
                                        </ui:CardControl>
                                        <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Play24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="Start Plex anyway" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="When off, Plex stays stopped until all drives are connected, so it doesn't mark media as unavailable." Style="{StaticResource RowDescription}" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ui:ToggleSwitch IsChecked="{Binding StartPlexOnMountFail}" />
                                        </ui:CardControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tray app -->
                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,28,36,16">
                                <StackPanel MaxWidth="900">
                                    <TextBlock Text="Tray app" Style="{StaticResource PageTitle}" />
                                    <TextBlock Style="{StaticResource PageDescription}" Text="Settings of this tray app, stored for your user on this computer." />

                                    <TextBlock Text="Connection" Style="{StaticResource SectionHeader}" Margin="2,0,0,8" />
                                    <Border Style="{StaticResource Panel}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,12">
                                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="PlugConnected24" FontSize="20" Margin="2,0,16,0" VerticalAlignment="Top" />
                                                <StackPanel>
                                                    <TextBlock Text="Computer running the service" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="Use localhost when Plex runs on this computer. The port is the service port (default 8787), not the Plex port 32400."
                                                               Style="{StaticResource RowDescription}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <Grid Margin="38,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Grid.Column="0" Style="{StaticResource Field}" PlaceholderText="localhost"
                                                            Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                                                <ui:NumberBox Grid.Column="2" Style="{StaticResource Number}" Width="Auto" Minimum="1" Maximum="65535"
                                                              SpinButtonPlacementMode="Hidden" PlaceholderText="Port"
                                                              Value="{Binding TrayPort, Converter={StaticResource IntToDouble}, ValidatesOnDataErrors=True}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />
                                    <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon PaintBrush24}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="Theme" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="System follows the Windows app mode. The accent color always comes from Windows." Style="{StaticResource RowDescription}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ComboBox Width="160" ItemsSource="{Binding BaseThemes}" SelectedItem="{Binding BaseTheme}" />
                                    </ui:CardControl>
                                    <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Alert24}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="Notifications" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="Show a notification when Plex starts, stops or updates." Style="{StaticResource RowDescription}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:ToggleSwitch IsChecked="{Binding ShowNotifications}" />
                                    </ui:CardControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- About -->
                        <TabItem>
                            <Grid Margin="36,28,36,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="About" Style="{StaticResource PageTitle}" />
                                    <TextBlock Text="Runs Plex Media Server as a Windows service." Style="{StaticResource PageDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1">
                                    <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Info24}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="Plex Service" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="{Binding Version}" Style="{StaticResource RowDescription}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Content="GitHub" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding ProjectUrl}" />
                                            <ui:Button Content="Report a problem" Margin="8,0,0,0" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding IssuesUrl}" />
                                        </StackPanel>
                                    </ui:CardControl>
                                    <TextBlock Text="License" Style="{StaticResource SectionHeader}" />
                                </StackPanel>
                                <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="6" Margin="0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                                        <TextBlock Text="{Binding LicenseText}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" LineHeight="20" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- footer -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="36,14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ui:Button Content="Cancel" MinWidth="100" Command="{Binding CancelCommand}" IsCancel="True" />
                                <ui:Button Content="Apply" MinWidth="100" Margin="8,0,0,0" Command="{Binding ApplyCommand}" />
                                <ui:Button Content="Save" MinWidth="100" Margin="8,0,0,0" Appearance="Primary" Command="{Binding SaveCommand}" IsDefault="True" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:SymbolIcon Symbol="Warning24" Margin="0,0,8,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                               Visibility="{Binding ValidationSummary, Converter={StaticResource NullToCollapsed}}" />
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding ValidationSummary}" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ValidationSummary}" Value="{x:Null}" />
                                                        <Condition Binding="{Binding IsDirty}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="You have unsaved changes" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
